# Google Analytics 4 Measurement ID (예: G-XXXXXXXXXX)
# 이 값이 비어 있으면 GA는 자동으로 비활성화됩니다 (dev 환경 기본).
# 운영 빌드에서는 .env.production 또는 빌드 환경 변수로 설정하세요.
VITE_GA_ID=

# Kakao JavaScript App Key (카카오 공유 기능용)
# https://developers.kakao.com 에서 앱 생성 후 JavaScript 키 입력
# 비어 있으면 카카오 공유 버튼이 오류 메시지를 표시합니다.
VITE_KAKAO_APP_KEY=
